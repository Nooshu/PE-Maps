{
  "name": "pe-maps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Proof of concept for a progressively enhanced maps blog post.",
  "scripts": {
    "build": "tsx src/build.ts",
    "check:deps": "node scripts/check-dependencies.mjs",
    "dev": "npm run build && concurrently -k \"tsx watch --include views --include src/client --include src/maps --include assets src/build.ts\" \"tsx watch src/server.ts\"",
    "maps:static": "tsx src/write-static-maps.ts",
    "preinstall": "node scripts/check-dependencies.mjs",
    "start": "npm run build && tsx src/server.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@defra/interactive-map": "0.0.48-alpha",
    "express": "5.2.1",
    "govuk-frontend": "6.5.1",
    "maplibre-gl": "6.10.0",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.1",
    "@types/nunjucks": "3.2.6",
    "@vitest/coverage-istanbul": "5.0.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "staticmaps": "1.13.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
