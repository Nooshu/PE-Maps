{% extends "layouts/base.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}Route map – GOV.UK{% endblock %}

{% block pageStyles %}
  <link rel="stylesheet" href="/stylesheets/interactive-map.css">
  <link rel="stylesheet" href="/stylesheets/interactive-map-datasets.css">
{% endblock %}

{% block mapLoading %}
  <script>document.body.classList.add('im-is-loading')</script>
{% endblock %}

{% block pageBeforeContent %}
  {{ govukBreadcrumbs({
    items: [
      {
        text: "Home",
        href: "/"
      },
      {
        text: "Route map"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Walking route from Buckingham Palace to Westminster Abbey</h1>
      <p class="govuk-body">
        Follow this walking route from Buckingham Palace to Westminster Abbey.
      </p>
      <div id="{{ map.containerId }}">
        <noscript>
          <img
            class="app-map-static"
            src="{{ map.staticImageSrc }}"
            width="{{ map.width }}"
            height="{{ map.height }}"
            alt="{{ map.mapLabel }}"
          >
          <p class="govuk-body-s">{{ map.staticImageAttribution }}</p>
        </noscript>
      </div>
      <div class="app-route-directions">
        <h2 class="govuk-heading-m">Walking directions</h2>
        <p class="govuk-body">{{ map.directions.summary }}</p>
        {{ govukTable(directionsTable) }}
      </div>
    </div>
  </div>
{% endblock %}

{% block pageScripts %}
  <script type="module" src="/javascripts/route-map.js"></script>
{% endblock %}
