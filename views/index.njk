{% extends "layouts/base.njk" %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% block pageTitle %}Example maps – GOV.UK{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Example maps</h1>
      <p class="govuk-body-l">
        Accessible map examples for GOV.UK services, using GOV.UK Frontend and the Defra Interactive Map.
      </p>

      <h2 class="govuk-heading-m">Examples</h2>
      {{ govukTaskList({
        idPrefix: "map-examples",
        items: [
          {
            title: {
              text: "Basic map"
            },
            hint: {
              text: "An accessible map of London, United Kingdom"
            },
            href: "/basic-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Open map button"
            },
            hint: {
              text: "A button opens the map of London. Try ?js=off to see the warning fallback"
            },
            href: "/open-map-button",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Route"
            },
            hint: {
              text: "A walking route from Buckingham Palace to Westminster Abbey"
            },
            href: "/route-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Flood risk"
            },
            hint: {
              text: "A flood warning for Bridgnorth Low Town, with a no-JavaScript fallback"
            },
            href: "/flood-risk-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Planning appeal"
            },
            hint: {
              text: "A Planning Inspectorate inquiry for a mixed-use development in Lewes"
            },
            href: "/planning-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Tree Preservation Order"
            },
            hint: {
              text: "Protected woodland and trees in Falkland, Fife"
            },
            href: "/tree-preservation-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Title extent"
            },
            hint: {
              text: "The registered land at Buckingham Palace"
            },
            href: "/title-extent-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Road networks"
            },
            hint: {
              text: "Proposed 20mph roads and strategic routes in central Birmingham"
            },
            href: "/road-network-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Countryside schemes"
            },
            hint: {
              text: "Eligible land around Bourton-on-the-Water"
            },
            href: "/countryside-schemes-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Local authority boundaries"
            },
            hint: {
              text: "Which council is responsible for a property on Filton Avenue"
            },
            href: "/local-authority-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Rights and interests"
            },
            hint: {
              text: "Rights of way and easements at a cottage in Castle Combe"
            },
            href: "/rights-and-interests-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Planning applications"
            },
            hint: {
              text: "Current and historic applications in York"
            },
            href: "/planning-applications-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          },
          {
            title: {
              text: "Transport statistics"
            },
            hint: {
              text: "Bus journeys per person in the West Midlands"
            },
            href: "/transport-statistics-map",
            status: {
              tag: {
                text: "Example"
              }
            }
          }
        ]
      }) }}
    </div>
  </div>
{% endblock %}
